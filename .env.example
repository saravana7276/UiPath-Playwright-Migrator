# Target Web Application URL (Optional - defaults to local test fixture)
# TARGET_URL=https://portal.example.com

# Local Dashboard Server Port (Optional - defaults to 3333)
# PORT=3333

# Optional: Atlassian Jira Integration (Only needed if fetching live Jira tickets)
# JIRA_URL=https://your-domain.atlassian.net
# JIRA_API_TOKEN=your_jira_api_token
# JIRA_USER=your_email@domain.com
