{
  "name": "uipath-playwright-migrator",
  "version": "1.0.0",
  "description": "UiPath Playwright Migrator: convert legacy UiPath automation workflows into modern Playwright tests across multiple languages and web applications",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dashboard": "node server.js",
    "migrate": "node ./orchestration/coordinator.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "uipath",
    "migration",
    "typescript",
    "python",
    "javascript",
    "csharp",
    "automation",
    "self-healing",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
